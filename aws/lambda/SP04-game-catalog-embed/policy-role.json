{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "InvokeTitanEmbeddings",
            "Effect": "Allow",
            "Action": "bedrock:InvokeModel",
            "Resource": "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
        },
        {
            "Sid": "ReadAttributes",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::game-catalog-dedup/attributes/*"
        },
        {
            "Sid": "WriteVectors",
            "Effect": "Allow",
            "Action": [
                "s3vectors:PutVectors",
                "s3vectors:GetIndex"
            ],
            "Resource": "arn:aws:s3vectors:us-east-1:<account_number>:bucket/game-catalog-vectors/*"
        }
    ]
}